{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitter.local/schemas/knowledge-index.schema.json",
  "title": "Sitter Knowledge Index",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": 1},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id", "title", "type", "evidence_status", "architecture_status",
        "path", "domains", "keywords", "related"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "type": {
          "enum": [
            "fact", "flow", "decision", "debt", "critical-surface", "glossary",
            "open-thread", "watchpoint"
          ]
        },
        "evidence_status": {"enum": ["candidate", "verified", "disputed"]},
        "architecture_status": {"enum": ["current", "target", "transitional", "legacy"]},
        "path": {"type": "string", "pattern": "^knowledge/"},
        "domains": {"type": "array", "items": {"type": "string"}},
        "keywords": {"type": "array", "items": {"type": "string"}},
        "related": {"type": "array", "items": {"type": "string"}},
        "reviewed_by": {"type": "string"},
        "reviewed_at": {"type": "string"},
        "source_change": {"type": "string"},
        "source_task": {"type": "string"},
        "source_commit": {"type": "string", "minLength": 7},
        "validity_surface": {"type": "array", "items": {"type": "string"}},
        "memory_key": {"type": "string", "minLength": 1},
        "supersedes": {"type": "array", "items": {"type": "string"}},
        "trigger_terms": {"type": "array", "items": {"type": "string"}},
        "trigger_condition": {"type": "string"},
        "authority_sha256": {"type": "string", "minLength": 12}
      },
      "additionalProperties": false
    }
  }
}
